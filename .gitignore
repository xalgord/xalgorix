# F-001: CJK font downloaded at build time. ~10MB TTF, embedded via
# //go:embed; rebuilding without re-downloading is fine. Originally
# distributed as OTF only (notofonts/noto-cjk), but fpdf's UTF8
# parser rejects OTF — we ship the SC TTF subset from Google Fonts.
internal/reporting/fonts/*.ttf
internal/reporting/fonts/*.otf

# F-001: test artifacts that get regenerated by `go test` runs. The
# golden (*.sha256) and the smoke (*chinese_smoke.pdf) are committed;
# the .actual.pdf is a failure-only diff helper and the smoke PDF
# can be regenerated by running the smoke test.
internal/reporting/testdata/*.actual.pdf

# Local-only ephemeral files used by release/commit tooling
.commit_msg.tmp
.pr_body.tmp
.release_notes.tmp

# Local-only spec/design docs (Kiro). Internal authoring scratch space —
# not part of the published source.
.kiro/
node_modules
research/
